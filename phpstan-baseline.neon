		# app/Listeners/ProcessInboundEmail.php but never baselined, plus
		# app/Concerns/HasSla.php (vendor's own dead trait) and the remaining
		# Listener defensive-null-guard conditions matching the RecalculateSlaCommand/
		# SlaService pattern above. See Task 13 progress-ledger entry for the full
		# investigation (28 entries covering 29 errors -- 1 entry matches 2
		# occurrences of an identical message in the same file).
		- message: '#^Trait App\\Concerns\\HasSla is used zero times and is not analysed\.$#'
		  path: app/Concerns/HasSla.php
		- message: '#^Parameter \#1 \$article of method App\\Services\\KnowledgeBaseService\:\:archiveArticle\(\) expects App\\Models\\KbArticle, Illuminate\\Database\\Eloquent\\Model\|int\|string\|null given\.$#'
